@* Message list with multi-select (FR-3.4). Large loads are paged in memory so the DOM stays small. *@
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="message-grid">
    @if (Error is not null)
    {
        <div class="error-bar">@Error</div>
    }
    else if (Loading)
    {
        <p class="hint">Loading…</p>
    }
    else if (Messages is null || Messages.Count == 0)
    {
        <p class="hint">No messages found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th class="select-col">
                        @* Tri-state header checkbox: checked = all loaded messages selected,
                           indeterminate = only some, unchecked = none. *@
                        <input type="checkbox"
                               @ref="_selectAll"
                               checked="@AllSelected"
                               disabled="@(SelectableCount == 0)"
                               title="@SelectAllTitle"
                               aria-label="@SelectAllTitle"
                               @onclick="() => AllSelectionToggled.InvokeAsync(!AllSelected)" />
                    </th>
                    <th>Seq</th>
                    @if (ShowSession)
                    {
                        <th>Session</th>
                    }
                    <th>Message ID</th>
                    <th>Subject</th>
                    @if (ShowDeadLetter)
                    {
                        <th>DLQ reason</th>
                        <th>Description</th>
                    }
                    <th>Enqueued (UTC)</th>
                    <th>Deliveries</th>
                    <th>Bytes</th>
                    <th>Lock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MessageDto message in PageMessages())
                {
                    <tr class="@(Selected == message ? "selected" : null)"
                        @onclick="() => SelectedChanged.InvokeAsync(message)">
                        <td class="select-col" @onclick:stopPropagation>
                            <input type="checkbox"
                                   checked="@(SelectedKeys.Contains(message.RowKey))"
                                   @onclick="() => SelectionToggled.InvokeAsync(message.RowKey)" />
                        </td>
                        <td>
                            @message.SequenceNumber
                            @if (message.State == MessageState.Deferred)
                            {
                                <span class="badge warn" title="Deferred: receives skip it; select it and use Receive deferred to settle it">deferred</span>
                            }
                        </td>
                        @if (ShowSession)
                        {
                            <td class="ellipsis" title="@message.SessionId">@message.SessionId</td>
                        }
                        <td class="ellipsis" title="@message.MessageId">@message.MessageId</td>
                        <td class="ellipsis" title="@message.Subject">@message.Subject</td>
                        @if (ShowDeadLetter)
                        {
                            <td class="ellipsis" title="@message.DeadLetterReason">@message.DeadLetterReason</td>
                            <td class="ellipsis" title="@message.DeadLetterErrorDescription">@message.DeadLetterErrorDescription</td>
                        }
                        <td>@message.EnqueuedTime?.ToString("u")</td>
                        <td>@message.DeliveryCount</td>
                        <td>@message.BodySizeBytes</td>
                        <td>
                            @if (message.LockedUntil is not null)
                            {
                                <span class="lock-countdown @(LockRemaining(message.LockedUntil.Value) <= TimeSpan.Zero ? "expired" : null)"
                                      title="@(message.SessionId is null ? "Peek-lock" : "Session lock") expires at @message.LockedUntil.Value.ToString("u") UTC">
                                    ⏱ @LockRemainingText(message.LockedUntil.Value)
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* The pager is the same for every sub-queue (Active, Scheduled, DLQ) — it shows the exact
           loaded count so a large fetch is never silently truncated. *@
        @if (Messages.Count > 0)
        {
            <div class="grid-pager">
                <button type="button" @onclick="() => _page = 0" disabled="@(_page == 0)" title="First page">«</button>
                <button type="button" @onclick="() => _page--" disabled="@(_page == 0)">Prev</button>
                <span class="muted">@(_page * _pageSize + 1)–@Math.Min((_page + 1) * _pageSize, Messages.Count) of @Messages.Count</span>
                <button type="button" @onclick="() => _page++" disabled="@(_page >= PageCount - 1)">Next</button>
                <button type="button" @onclick="() => _page = PageCount - 1" disabled="@(_page >= PageCount - 1)" title="Last page">»</button>
                <select @bind="_pageSize" title="Rows per page">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="250">250</option>
                </select>
            </div>
        }
    }
</div>

@code {
    // The countdown is computed at render time; the periodic auto-refresh tick re-renders the
    // grid, so the display stays roughly current while polling is on.
    private static TimeSpan LockRemaining(DateTimeOffset lockedUntil)
        => lockedUntil - DateTimeOffset.UtcNow;

    private static string LockRemainingText(DateTimeOffset lockedUntil)
    {
        TimeSpan remaining = LockRemaining(lockedUntil);
        return remaining <= TimeSpan.Zero
            ? "expired"
            : $"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}";
    }

    [Parameter]
    public IReadOnlyList<MessageDto>? Messages { get; set; }

    // Shown only when sessions are in play, so plain queues keep the narrow grid.
    private bool ShowSession => Messages?.Any(message => message.SessionId is not null) == true;

    // Dead-letter views (and anything else carrying a reason) say why each message landed there.
    private bool ShowDeadLetter => Messages?.Any(message => message.DeadLetterReason is not null || message.DeadLetterErrorDescription is not null) == true;

    [Parameter]
    public MessageDto? Selected { get; set; }

    [Parameter]
    public EventCallback<MessageDto> SelectedChanged { get; set; }

    /// <summary>Row keys (<see cref="MessageDto.RowKey"/>) of the selected messages.</summary>
    [Parameter]
    public IReadOnlySet<string> SelectedKeys { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> SelectionToggled { get; set; }

    // True selects every loaded message, false clears the whole selection.
    [Parameter]
    public EventCallback<bool> AllSelectionToggled { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Error { get; set; }

    private int _page;
    private int _pageSize = 50;
    private int _renderedCount = -1;
    private ElementReference _selectAll;
    private IJSObjectReference? _module;
    private bool _indeterminate;

    private int SelectableCount => Messages?.Count ?? 0;

    private int SelectedCount => Messages?.Count(message => SelectedKeys.Contains(message.RowKey)) ?? 0;

    private bool AllSelected => SelectableCount > 0 && SelectedCount == SelectableCount;

    private string SelectAllTitle => AllSelected ? "Clear the selection" : $"Select all {SelectableCount} loaded message(s)";

    private int PageCount => Messages is null || Messages.Count == 0
        ? 1
        : (Messages.Count + _pageSize - 1) / _pageSize;

    // A new load (or a filter change) can shrink the list under the current page — snap back in range.
    protected override void OnParametersSet()
    {
        int count = Messages?.Count ?? 0;
        if (count != _renderedCount)
        {
            _renderedCount = count;
            _page = 0;
        }

        _page = Math.Clamp(_page, 0, PageCount - 1);
    }

    // The indeterminate state is a DOM property, so it has to be pushed after each render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Messages is null || Messages.Count == 0 || Error is not null || Loading)
        {
            return;
        }

        bool indeterminate = SelectedCount > 0 && !AllSelected;
        if (!firstRender && indeterminate == _indeterminate)
        {
            return;
        }

        _indeterminate = indeterminate;
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/checkbox.js");
        await _module.InvokeVoidAsync("setIndeterminate", _selectAll, indeterminate);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone — nothing to clean up on the client.
            }
        }
    }

    private IEnumerable<MessageDto> PageMessages()
        => Messages!.Skip(_page * _pageSize).Take(_pageSize);
}
