@* Entity management: create/edit/delete the entity types the connection's provider describes
   (ADR 21). The form is built from that schema, so no broker setting is hard-coded here. Only
   renders actionable UI when the active connection declares CanManageEntities (FR-6). *@
@using MessagingToolbox.Web.Services.Filtering
@inherits ToolboxComponentBase
@implements IDisposable

<div class="entity-editor">
    @if (CanManage)
    {
        @foreach (EntityTypeDescriptor type in _types)
        {
            <button type="button" @onclick="() => StartCreate(type)">New @type.Label…</button>
        }
        @if (_types.Count > 0)
        {
            <button type="button" @onclick="StartEdit">Edit entity…</button>
            <button type="button" class="danger" @onclick="StartDelete">Delete entity…</button>
        }
        @if (_typesError is not null)
        {
            <p class="hint">@_typesError</p>
        }
    }
</div>

@if (_showEditor && _type is { } editedType)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog entity-editor-dialog" role="dialog" aria-modal="true">
            <h3>@EditorTitle</h3>
            @if (editedType.Description is { } typeDescription)
            {
                <p class="hint">@typeDescription</p>
            }

            <div class="entity-form">
                @if (editedType.ParentKind is { } parentKind)
                {
                    <label>
                        Parent @ParentLabel(parentKind)
                        <select @bind="_parentPath" disabled="@_isEdit">
                            <option value="">— select —</option>
                            @foreach (EntityTreeNodeDto parent in AllEntities().Where(entity => entity.Kind == parentKind))
                            {
                                <option value="@parent.Path">@parent.Name</option>
                            }
                        </select>
                    </label>
                }

                <label>
                    Name
                    <input type="text" @bind="_name" disabled="@_isEdit" />
                </label>

                <EntityOptionInputs Options="editedType.Options" Form="_form" IsLocked="option => _isEdit && option.CreateOnly" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-bar">@_error</div>
            }

            <div class="confirm-actions">
                @if (CanSave)
                {
                    <button class="primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                }
                <button @onclick="CloseEditor" disabled="@_saving">@(CanSave ? "Cancel" : "Close")</button>
            </div>
        </div>
    </div>
}

@if (_showEntityPicker)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog" role="dialog" aria-modal="true">
            <h3>@_pickerTitle</h3>
            <p class="hint">@_pickerDescription</p>
            <select class="entity-picker" @bind="_selectedEntityPath">
                <option value="">— select entity —</option>
                @foreach (EntityTreeNodeDto entity in ManageableEntities())
                {
                    <option value="@entity.Path">@entity.Path</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_pickerError))
            {
                <div class="error-bar">@_pickerError</div>
            }

            <div class="confirm-actions">
                <button class="primary" @onclick="PickerConfirmAsync" disabled="@string.IsNullOrEmpty(_selectedEntityPath)">@_pickerConfirmLabel</button>
                <button @onclick="ClosePicker">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="Delete entity"
               Message="@_deleteMessage"
               ConfirmLabel="Delete"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    [Parameter]
    public Guid ConnectionId { get; set; }

    [Parameter]
    public ProviderCapabilities? Capabilities { get; set; }

    [Parameter]
    public IReadOnlyList<EntityTreeNodeDto> Entities { get; set; } = [];

    private readonly CancellationTokenSource _disposalTokenSource = new();

    private IReadOnlyList<EntityTypeDescriptor> _types = [];
    private string? _typesError;
    private (Guid ConnectionId, bool CanManage)? _typesLoadedFor;

    private bool _showEditor;
    private bool _isEdit;
    private bool _saving;
    private string? _error;
    private EntityTypeDescriptor? _type;
    private string _name = string.Empty;
    private string _parentPath = string.Empty;

    private readonly EntityOptionForm _form = new();

    private bool _showEntityPicker;
    private string? _pickerTitle;
    private string? _pickerDescription;
    private string? _pickerConfirmLabel;
    private Func<Task>? _pickerConfirmAction;
    private string? _pickerError;
    private string _selectedEntityPath = string.Empty;

    private bool _showDeleteConfirm;
    private string _deleteMessage = string.Empty;

    private bool CanManage => Capabilities?.CanManageEntities == true;

    private string EditorTitle => _isEdit ? $"Edit {_type?.Label}" : $"New {_type?.Label}";

    // Editing an entity whose every setting is fixed at creation has nothing to save.
    private bool CanSave => !_isEdit || _type?.Options.Any(option => !option.CreateOnly) == true;

    // The schema belongs to the connection; reload it when the connection or its management state changes.
    protected override async Task OnParametersSetAsync()
    {
        (Guid, bool) key = (ConnectionId, CanManage);
        if (_typesLoadedFor == key)
        {
            return;
        }

        _typesLoadedFor = key;
        _types = [];
        _typesError = null;
        if (!CanManage)
        {
            return;
        }

        try
        {
            _types = await Mediator.Send(new GetEntityTypesQuery(ConnectionId), _disposalTokenSource.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _typesError = exception.Message;
        }
    }

    private IEnumerable<EntityTreeNodeDto> AllEntities()
        => EntityTreeFiltering.Flatten(Entities).Where(entity => !entity.IsSubQueueNode);

    private IEnumerable<EntityTreeNodeDto> ManageableEntities()
        => AllEntities().Where(entity => _types.Any(type => type.Kind == entity.Kind));

    private string ParentLabel(EntityKind parentKind)
        => _types.FirstOrDefault(type => type.Kind == parentKind)?.Label ?? parentKind.ToString().ToLowerInvariant();

    private void StartCreate(EntityTypeDescriptor type)
    {
        _isEdit = false;
        _type = type;
        _name = string.Empty;
        _parentPath = string.Empty;
        _form.LoadDefaults(type.Options);
        _error = null;
        _showEditor = true;
    }

    private void StartEdit()
    {
        _pickerTitle = "Edit entity";
        _pickerDescription = "Choose an existing entity to edit.";
        _pickerConfirmLabel = "Edit";
        _pickerError = null;
        _selectedEntityPath = string.Empty;
        _pickerConfirmAction = LoadEntityForEditAsync;
        _showEntityPicker = true;
    }

    private void StartDelete()
    {
        _pickerTitle = "Delete entity";
        _pickerDescription = "Choose an existing entity to delete.";
        _pickerConfirmLabel = "Choose";
        _pickerError = null;
        _selectedEntityPath = string.Empty;
        _pickerConfirmAction = ConfirmDeleteAsync;
        _showEntityPicker = true;
    }

    private async Task PickerConfirmAsync()
    {
        if (_pickerConfirmAction is not null)
        {
            await _pickerConfirmAction();
        }
    }

    private void ClosePicker()
    {
        _showEntityPicker = false;
        _pickerConfirmAction = null;
        _selectedEntityPath = string.Empty;
    }

    private async Task LoadEntityForEditAsync()
    {
        if (string.IsNullOrEmpty(_selectedEntityPath))
        {
            return;
        }

        _pickerError = null;

        try
        {
            EntityDefinitionDto definition = await Mediator.Send(
                new GetEntityDefinitionQuery(ConnectionId, _selectedEntityPath),
                _disposalTokenSource.Token);

            EntityTypeDescriptor? type = _types.FirstOrDefault(candidate => candidate.Kind == definition.Kind);
            if (type is null)
            {
                _pickerError = $"This connection can't edit a {definition.Kind}.";
                return;
            }

            _isEdit = true;
            _type = type;
            _name = definition.Name;
            _parentPath = definition.ParentPath ?? string.Empty;
            _form.Load(type.Options, definition.Options);
            _error = null;
            _showEntityPicker = false;
            _showEditor = true;
        }
        catch (Exception exception)
        {
            _pickerError = exception.Message;
        }
    }

    private Task ConfirmDeleteAsync()
    {
        if (!string.IsNullOrEmpty(_selectedEntityPath))
        {
            _deleteMessage = $"Permanently delete {_selectedEntityPath}, including any messages it holds? This cannot be undone.";
            _showEntityPicker = false;
            _showDeleteConfirm = true;
        }

        return Task.CompletedTask;
    }

    private async Task DeleteConfirmedAsync()
    {
        _showDeleteConfirm = false;

        try
        {
            await Mediator.Send(
                new DeleteEntityCommand(ConnectionId, _selectedEntityPath),
                _disposalTokenSource.Token);

            _selectedEntityPath = string.Empty;
        }
        catch (Exception exception)
        {
            _pickerError = exception.Message;
            _showEntityPicker = true;
        }
    }

    private async Task SaveAsync()
    {
        if (_type is null || !TryBuildOptions(_type, out Dictionary<string, object?> options))
        {
            return;
        }

        _saving = true;
        _error = null;

        try
        {
            await Mediator.Send(
                new CreateOrUpdateEntityCommand(ConnectionId, _name.Trim(), _type.Kind, NullIfEmpty(_parentPath), options),
                _disposalTokenSource.Token);

            CloseEditor();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private bool TryBuildOptions(EntityTypeDescriptor type, out Dictionary<string, object?> options)
    {
        options = [];

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return false;
        }

        if (type.ParentKind is { } parentKind && string.IsNullOrWhiteSpace(_parentPath))
        {
            _error = $"Choose the parent {ParentLabel(parentKind)}.";
            return false;
        }

        return _form.TryBuild(type.Options, out options, out _error);
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _isEdit = false;
        _error = null;
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    public void Dispose()
    {
        _disposalTokenSource.Cancel();
        _disposalTokenSource.Dispose();
    }
}
