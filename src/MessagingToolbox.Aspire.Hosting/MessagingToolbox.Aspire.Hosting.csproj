<Project Sdk="Microsoft.NET.Sdk">

    <!-- The one packable project in Phase 1 (DevOps guidelines §5); IsPackable defaults to false at the root. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>MessagingToolbox.Aspire.Hosting</PackageId>
        <Title>MessagingToolbox: message broker explorer for .NET Aspire</Title>
        <Description>Message broker explorer for local development with .NET Aspire. Browse, send and manage messages from your AppHost: the Azure Service Bus emulator and RabbitMQ.</Description>
        <PackageTags>aspire;dotnet-aspire;aspire-hosting;azure-service-bus;servicebus;azure-service-bus-emulator;service-bus-emulator;servicebus-emulator;service-bus-explorer;servicebus-explorer;rabbitmq;rabbitmq-management;amqp;emulator;message-broker;broker-explorer;queue-explorer;message-explorer;dead-letter;queues;topics;messaging;local-development;devtools;blazor</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
        <!-- Reads the AppHost-modeled queues/topics/subscriptions for emulator discovery (architecture doc §8). -->
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
        <!-- Recognizes RabbitMQ server resources and their management endpoint. -->
        <PackageReference Include="Aspire.Hosting.RabbitMQ" />
        <!-- Lifts Aspire's vulnerable transitive MessagePack to a patched version, for consumers too. -->
        <PackageReference Include="MessagePack" />
    </ItemGroup>

    <!-- Pins the container image to the package version for tag builds (v* tags push both the
         NuGet and the image tag of the same version); other builds follow `edge`. -->
    <Target Name="StampContainerImageTag" AfterTargets="MinVer" Condition="'$(GITHUB_REF_TYPE)' == 'tag' AND '$(MinVerVersion)' != ''">
        <ItemGroup>
            <AssemblyMetadata Include="ContainerImageTag" Value="$(MinVerVersion)" />
        </ItemGroup>
    </Target>

</Project>
